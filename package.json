{
  "name": "exventure-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3003",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3003",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.3.5",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jose": "6.2.12",
    "typescript": "5.9.3"
  }
}
