# Approved isolated QA stacks only. Blank credentials are supplied privately by the infrastructure owner.
# This template creates no stack, credential, OAuth client, account or permission.
# Every browser navigation must use 127.0.0.1; localhost and other ports are refused.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3003
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
WEBSITE_LOCAL_INTEGRATION_ENABLED=false
WEBSITE_INQUIRY_MODE=disabled
WEBSITE_INQUIRY_ORIGIN=http://127.0.0.1:3003
WEBSITE_INQUIRY_DB_ENVIRONMENT=local-test
WEBSITE_INQUIRY_DB_URL=http://127.0.0.1:58621
WEBSITE_INQUIRY_LOCAL_PROJECT_ID=exventure-website-ui-qa
WEBSITE_COMPANY_LOCAL_PROJECT_ID=exventure-accounts-ui-qa
WEBSITE_INQUIRY_DB_SECRET_KEY=
WEBSITE_INQUIRY_SIGNING_SECRET=
# Public client, token_endpoint_auth_method=none, Authorization Code + S256.
# Register exactly http://127.0.0.1:3003/auth/company/callback on the accounts QA stack.
# Issuer is fixed in code: http://127.0.0.1:58421/auth/v1. No client secret or issuer override exists.
WEBSITE_COMPANY_SSO_ENABLED=false
WEBSITE_COMPANY_AUTH_PROVISIONED=false
WEBSITE_COMPANY_OIDC_CLIENT_ID=
WEBSITE_COMPANY_SESSION_KEY=
WEBSITE_COMPANY_ADMIN_ACCOUNT_ID=
WEBSITE_COMPANY_TEST_PORTAL_ORIGIN=http://127.0.0.1:3002
WEBSITE_COMPANY_TEST_PROJECT_REF=
WEBSITE_INQUIRY_TEST_PROJECT_REF=
# The synthetic role fixture cannot grant access in this Supabase/OAuth mode.
WEBSITE_INQUIRY_LOCAL_ADMIN_ROLE=viewer
WEBSITE_INQUIRY_PURGE_ENABLED=false
# These production policy approvals remain false; this local mode displays only a synthetic test notice.
WEBSITE_INQUIRY_POLICY_APPROVED=false
WEBSITE_INQUIRY_PROCESSOR_REVIEW_APPROVED=false
WEBSITE_INQUIRY_POLICY_JSON=
WEBSITE_INQUIRY_PRIVACY_DETAILS_JSON=
WEBSITE_INQUIRY_RETENTION_OPERATIONS_APPROVED=false
