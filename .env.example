NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3003
NEXT_PUBLIC_SUPABASE_URL=https://your-website-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Inquiry collection is OFF until policy, isolation, administrator access and retention operations are reviewed.
# These variables are separate from the existing public connection; never reuse its production DB in Preview.
WEBSITE_INQUIRY_MODE=disabled
WEBSITE_INQUIRY_ORIGIN=http://127.0.0.1:3003
WEBSITE_INQUIRY_SIGNING_SECRET=
WEBSITE_INQUIRY_POLICY_APPROVED=false
WEBSITE_INQUIRY_PROCESSOR_REVIEW_APPROVED=false
WEBSITE_INQUIRY_POLICY_JSON=
WEBSITE_INQUIRY_PRIVACY_DETAILS_JSON=
WEBSITE_INQUIRY_DB_ENVIRONMENT=
WEBSITE_INQUIRY_DB_URL=
WEBSITE_INQUIRY_TEST_PROJECT_REF=
WEBSITE_INQUIRY_DB_SECRET_KEY=

# Explicit loopback-only synthetic administrator fixture. Never supported on Vercel.
WEBSITE_INQUIRY_LOCAL_ADMIN_ROLE=viewer

# The public privacy/deletion email lives in website_private.settings, not in the login email or source code.
# Its initial value is empty; an authorized website admin must set it before collecting inquiries.
# Existing central public-client OIDC/PKCE contract. All values are provisioning slots, disabled by default.
WEBSITE_COMPANY_SSO_ENABLED=false
WEBSITE_COMPANY_AUTH_PROVISIONED=false
WEBSITE_COMPANY_OIDC_CLIENT_ID=
WEBSITE_COMPANY_SESSION_KEY=
WEBSITE_COMPANY_ADMIN_ACCOUNT_ID=
# Nonproduction central Auth must be isolated too; reserved production refs/portal are rejected.
WEBSITE_COMPANY_TEST_PROJECT_REF=
WEBSITE_COMPANY_TEST_PORTAL_ORIGIN=
# Administrator-triggered expiry purge only. No scheduler, shared-secret endpoint or real deletion is enabled.
WEBSITE_INQUIRY_PURGE_ENABLED=false
WEBSITE_INQUIRY_RETENTION_OPERATIONS_APPROVED=false

# Fixed isolated HTTP integration contract, OFF on normal environments and always refused on Vercel.
# See .env.local-integration.example; never enable these flags in Production/Preview.
WEBSITE_LOCAL_INTEGRATION_ENABLED=false
WEBSITE_INQUIRY_LOCAL_PROJECT_ID=
WEBSITE_COMPANY_LOCAL_PROJECT_ID=
